{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis Overlay",
  "version": "0.1.0",
  "identifier": "app.jarvis.overlay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jarvis Overlay",
        "width": 420,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
